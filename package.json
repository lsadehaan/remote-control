{
  "name": "remote-control",
  "version": "1.0.0",
  "private": true,
  "description": "Remote Control Interface for AI Agents",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter @remote-control/backend run dev",
    "dev:frontend": "pnpm --filter @remote-control/frontend run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
